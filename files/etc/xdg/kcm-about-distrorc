# KDE "About this System" (kinfocenter). Name, version and variant come from
# /usr/lib/os-release (AgentUX's, see the Containerfile); this file replaces
# Fedora's (kde-settings), which pointed the logo at Fedora's.
# UseOSReleaseVersion shows VERSION (the build's date, "AgentUX 2026.10.15")
# rather than VERSION_ID (44, Fedora's release, which is not AgentUX's).
# ExtraSoftwareData adds two lines from scripts: the AgentUX release and
# channel this system runs (from the booted image, see agentux-version) and
# the Fedora release it is based on.
[General]
LogoPath=/usr/share/icons/hicolor/256x256/apps/agentux.png
Website=https://agentuxos.org
UseOSReleaseVersion=true
ExtraSoftwareData=/usr/libexec/agentux/about-release;/usr/libexec/agentux/about-base
