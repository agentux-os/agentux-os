#!/usr/bin/bash
# Seeds the AgentUX Hyprland configuration into the user's ~/.config, run by
# /usr/libexec/agentux/hyprland-session before Hyprland starts (Hyprland,
# hyprlock, hypridle, mako and the rest only read ~/.config).
#
# Every file under /usr/share/agentux/hyprland/user/ is copied to the same
# path under ~/.config unless the user already has it, so nothing the user
# wrote is ever overwritten. The one exception is a hyprland.conf Hyprland
# generated itself (it does so when started without one, e.g. from the stock
# "Hyprland" session): that one is moved aside to hyprland.conf.autogenerated
# and replaced. ~/.config/hypr/hyprland.conf only sources AgentUX's defaults
# from /usr/share/agentux/hyprland, so image updates reach existing users; the
# other files are full copies the user owns.
set -uo pipefail

src=/usr/share/agentux/hyprland/user
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"

hypr="$cfg/hypr/hyprland.conf"
if [[ -f "$hypr" ]] && grep -qE '^[[:space:]]*autogenerated[[:space:]]*=[[:space:]]*1' "$hypr"; then
    mv -f "$hypr" "$hypr.autogenerated"
fi
# Waybar takes config or config.jsonc; either counts as the user's own.
waybar_has_config() { [[ -e "$cfg/waybar/config" || -e "$cfg/waybar/config.jsonc" ]]; }

rc=0
while IFS= read -r -d '' file; do
    rel="${file#"$src"/}"
    dest="$cfg/$rel"
    [[ -e "$dest" ]] && continue
    [[ "$rel" == waybar/config.jsonc ]] && waybar_has_config && continue
    if mkdir -p "$(dirname "$dest")" && cp "$file" "$dest"; then
        echo "agentux: seeded $dest"
    else
        echo "agentux: could not seed $dest" >&2
        rc=1
    fi
done < <(find "$src" -type f -print0 | sort -z)
exit "$rc"
