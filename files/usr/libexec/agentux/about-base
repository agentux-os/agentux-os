#!/usr/bin/bash
# KDE's About this System runs this (ExtraSoftwareData in
# /etc/xdg/kcm-about-distrorc): the Fedora release AgentUX is built on, from
# the base image's os-release, labelled as the base. Always two lines.
base="$(sed -n 's/^PRETTY_NAME=//p' /usr/share/agentux/os-release.base 2>/dev/null | sed 's/^"\(.*\)"$/\1/' | head -n1)"
printf 'Based on:\n%s\n' "${base:-Fedora Linux}"
