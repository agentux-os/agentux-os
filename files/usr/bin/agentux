#!/usr/bin/bash
set -euo pipefail

catalog="${AGENTUX_PROFILE_CATALOG:-/usr/share/agentux/profiles/catalog.json}"
state="${AGENTUX_PROFILE_STATE:-/var/lib/agentux/profile.json}"

die() { echo "agentux: $*" >&2; exit 2; }
need_jq() { command -v jq >/dev/null 2>&1 || die "jq is required"; }
usage() {
    cat >&2 <<'EOF'
usage: agentux profile {show|plan|apply} PROFILE [--components a,b,...]
       agentux profile seed PROFILE
       agentux profile apply-intent
       agentux profile remove COMPONENT
EOF
    exit 2
}

write_state() {
    local profile="$1" applied="$2" pending="$3" failed="$4" status="$5"
    mkdir -p "$(dirname "$state")"
    local tmp
    tmp="$(mktemp "${state}.XXXXXX")"
    jq -cn --argjson version "$(jq '.catalogVersion' "$catalog")" \
        --arg profile "$profile" --argjson applied "$applied" \
        --argjson pending "$pending" --argjson failed "$failed" \
        --arg status "$status" \
        '{catalogVersion:$version,requested:(if $profile == "" then null else $profile end),status:$status,applied:$applied,pending:$pending,failed:$failed}' \
        >"$tmp"
    mv -f "$tmp" "$state"
}

profile_cmd() {
    need_jq
    [[ -r "$catalog" ]] || die "profile catalog not found: $catalog"
    jq -e '.catalogVersion and (.profiles | type == "object") and (.components | type == "object")' \
        "$catalog" >/dev/null || die "invalid profile catalog: $catalog"
    local action value components_arg
    action="${1:-}"
    value="${2:-}"
    components_arg=""
    [[ -n "$action" ]] || usage
    if [[ "$action" != show && "$action" != apply-intent && -z "$value" ]]; then
        usage
    fi
    if [[ "${3:-}" == --components && -n "${4:-}" ]]; then
        components_arg="$4"
    elif [[ -n "${3:-}" ]]; then
        usage
    fi

    case "$action" in
        show)
            if [[ -r "$state" ]]; then
                jq -c . "$state"
            else
                jq -cn --argjson version "$(jq '.catalogVersion' "$catalog")" \
                    '{catalogVersion:$version,requested:null,status:"unconfigured",applied:[],pending:[],failed:[]}'
            fi
            ;;
        plan|apply)
            jq -e --arg profile "$value" '.profiles[$profile]' "$catalog" >/dev/null \
                || die "unknown profile: $value"
            local components
            if [[ "$value" == custom ]]; then
                [[ -n "$components_arg" ]] || die "custom profile requires --components"
                components="$(tr ',' '\n' <<<"$components_arg" | jq -Rsc 'split("\n") | map(select(length > 0)) | unique')"
                while IFS= read -r component; do
                    jq -e --arg component "$component" '.components[$component]' "$catalog" >/dev/null \
                        || die "unknown component: $component"
                done < <(jq -r '.[]' <<<"$components")
            else
                [[ -z "$components_arg" ]] || die "--components is only valid for custom"
                components="$(jq -c --arg profile "$value" \
                    '.profiles[$profile].components | unique' "$catalog")"
            fi
            jq -cn --arg profile "$value" --argjson components "$components" \
                '{profile:$profile,components:$components}'
            if [[ "$action" == apply ]]; then
                local previous_applied error failed
                previous_applied='[]'
                [[ -r "$state" ]] && previous_applied="$(jq -c '.applied // []' "$state")"
                write_state "$value" "$previous_applied" "$components" '[]' pending
                if [[ "$(jq -r 'index("command-server") // empty' <<<"$components")" != "" ]]; then
                    [[ -x /usr/libexec/agentux/profile-command ]] \
                        || die "Command profile support is unavailable"
                    if ! error="$('/usr/libexec/agentux/profile-command' 2>&1)"; then
                        failed="$(jq -cn --arg error "$error" '[{component:"command-server",error:$error}]')"
                        write_state "$value" "$previous_applied" "$components" "$failed" failed
                        printf '%s\n' "$error" >&2
                        return 1
                    fi
                fi
                write_state "$value" "$components" '[]' '[]' applied
            fi
            ;;
        seed)
            jq -e --arg profile "$value" '.profiles[$profile]' "$catalog" >/dev/null \
                || die "unknown profile: $value"
            mkdir -p "$(dirname "$state")"
            local intent tmp
            intent="$(dirname "$state")/profile-intent.json"
            tmp="$(mktemp "${intent}.XXXXXX")"
            jq -cn --argjson version "$(jq '.catalogVersion' "$catalog")" \
                --arg profile "$value" \
                '{catalogVersion:$version,profile:$profile}' >"$tmp"
            mv -f "$tmp" "$intent"
            ;;
        apply-intent)
            local intent profile
            intent="$(dirname "$state")/profile-intent.json"
            [[ -r "$intent" ]] || exit 0
            profile="$(jq -er '.profile' "$intent")" || die "invalid profile intent: $intent"
            profile_cmd apply "$profile" >/dev/null
            rm -f "$intent"
            ;;
        remove)
            local component applied dependents remaining
            component="$value"
            [[ -n "$component" ]] || usage
            [[ -r "$state" ]] || die "no active profile"
            applied="$(jq -c '.applied // []' "$state")"
            jq -e --arg component "$component" 'index($component) != null' <<<"$applied" >/dev/null \
                || die "component is not applied: $component"
            case "$component" in
                node)
                    dependents="desktop,node-gateway"
                    ;;
                command-server)
                    die "command-server removal requires operator teardown; data is never deleted implicitly"
                    ;;
                *)
                    dependents=""
                    ;;
            esac
            for dependent in ${dependents//,/ }; do
                jq -e --arg component "$dependent" 'index($component) != null' <<<"$applied" >/dev/null \
                    && die "cannot remove $component while $dependent depends on it"
            done
            remaining="$(jq -c --arg component "$component" 'map(select(. != $component))' <<<"$applied")"
            write_state "$(jq -r '.requested // "custom"' "$state")" "$remaining" '[]' '[]' applied
            ;;
        *) usage ;;
    esac
}

[[ "${1:-}" == profile ]] || usage
shift
profile_cmd "$@"
