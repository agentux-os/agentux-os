[Unit]
Description=Install AgentUX per-user tools (agent CLIs, dev tools)
ConditionPathExists=!%S/agentux/first-login.done
# Only for people: a system user with a session of its own, like
# plasma-setup running the first-boot wizard, must not download several GB of
# agent CLIs into its tmpfs home.
ConditionUser=!@system
# network-online.target exists only in the system manager, so a user unit
# cannot order itself after it; ExecStartPre below waits for the network
# instead. Retries within a session are bounded: at most 4 starts per hour,
# after that the unit stays failed until the next login.
StartLimitIntervalSec=1h
StartLimitBurst=4

[Service]
Type=oneshot
# Wait up to a minute for NetworkManager to have a connection up. Offline, the
# unit fails and is retried below, and again on the next login.
ExecStartPre=/usr/bin/nm-online -q -t 60
ExecStart=/usr/libexec/agentux/first-login
Restart=on-failure
RestartSec=5min

[Install]
WantedBy=default.target
