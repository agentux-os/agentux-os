# AgentUX boot splash (Plymouth script plugin).
#
# The swimming penguin, the AgentUX mark, swims in place in the middle of an
# Ink screen, the wordmark below it: it bobs gently, pitching with the bob,
# its flipper strokes, the water of its wake streams back past it and bubbles
# rise from its back, drift back and fade. One more water line under the
# wordmark, a Lime wave filling a Graphite one, shows boot progress; the
# passphrase prompt (LUKS), messages and the shutdown, reboot and update
# modes reuse the same layout. Sizes are for a 1080p screen and scale with
# the screen; the images come at 1x and @2x from plymouth/build.py in
# agentux-os, which also writes the generated constants below.

# Generated by plymouth/build.py from the brand's penguin.svg (do not edit):
# the water sheet, and the moving parts' geometry in 1080p pixels from the
# mark's top-left corner (the mark is 256 px wide, MARK_H high).
FRAMES = 25;        # frames in water.png / water@2x.png
COLUMNS = 5;       # frames per row in those sheets
TICKS = 2;         # refresh ticks (50 Hz) per frame
MARK_H = 89.95;
PIVOT_X = 173.68;       # the penguin pitches around this point (penguin.png's centre)
PIVOT_Y = 45.04;
ROOT_X = 150.05;        # the flipper strokes around its root (flipper.png's centre)
ROOT_Y = 61.42;
WATER_X = 0.0;       # water.png's frames' top-left corner
WATER_Y = 12.3;
SPAWN_X0 = 121.29;      # where bubbles appear: three points by the end of its back
SPAWN_Y0 = 30.54;
SPAWN_X1 = 113.8;
SPAWN_Y1 = 22.12;
SPAWN_X2 = 108.19;
SPAWN_Y2 = 38.03;

# The motion (agentux-desktop's login splash copies these). Ticks are
# Plymouth's 50 Hz refreshes; lengths are 1080p pixels, scaled with the screen.
CYCLE = 200;           # one swim cycle: a bob, its pitch and two flipper strokes (4 s)
BOB = 3;               # the bob's amplitude, up and down
PITCH = 0.026;         # the pitch's amplitude in radians (1.5 degrees), nose up while rising
FLAP = 0.14;           # the flipper's stroke in radians (8 degrees), twice per CYCLE
BUBBLE_COUNT = 4;      # bubbles at a time
BUBBLE_EVERY = 25;     # ticks between two bubbles (0.5 s)
BUBBLE_LIFE = 100;     # ticks a bubble lives (2 s)
BUBBLE_VX = 42;        # px/s backwards
BUBBLE_VY = 8;         # px/s upwards
BUBBLE_WOBBLE = 2;     # px sideways, 1.5 swings over its life
BUBBLE_ALPHA = 0.55;   # its opacity in the middle of its life (fading in and out)

Window.SetBackgroundTopColor(0.043, 0.051, 0.063);
Window.SetBackgroundBottomColor(0.043, 0.051, 0.063);

fun text_image(text, size, r, g, b, a) {
    return Image.Text(text, r, g, b, a, "Sans " + Math.Int(Math.Max(size * global.scale, 9)));
}
fun slate(text, size) { return text_image(text, size, 0.580, 0.616, 0.671, 1); }
fun mist(text, size) { return text_image(text, size, 0.906, 0.918, 0.937, 1); }

# An image from the 1x or @2x set, scaled to the screen.
fun load(name) {
    img = Image(name + global.suffix + ".png");
    return scaled(img, global.k);
}
fun scaled(img, f) {
    if (f == 1)
        return img;
    return img.Scale(Math.Max(Math.Int(img.GetWidth() * f + 0.5), 1),
                     Math.Max(Math.Int(img.GetHeight() * f + 0.5), 1));
}

fun place(sprite, image, x, y, z) {
    sprite.SetImage(image);
    sprite.SetPosition(Math.Int(x), Math.Int(y), z);
}

water = Sprite();
penguin = Sprite();
flipper = Sprite();
wordmark = Sprite();
water.SetOpacity(0);
penguin.SetOpacity(0);
flipper.SetOpacity(0);
wordmark.SetOpacity(0);
bubbles = [];
for (i = 0; i < BUBBLE_COUNT; i++) {
    bubbles[i] = Sprite();
    bubbles[i].SetOpacity(0);
}
track = Sprite();
fill = Sprite();
status = Sprite();
message = Sprite();
prompt = Sprite();
entry = Sprite();
capslock = Sprite();
bullets = [];

state = "normal";      # normal, password or question
progress = 0;
tick = 0;
fade = 0;
message_text = "";

mode = Plymouth.GetMode();
if (mode == "shutdown")
    status_text = "Shutting down";
else if (mode == "reboot")
    status_text = "Restarting";
else if (mode == "updates" || mode == "system-upgrade")
    status_text = "Installing updates, don't turn off your computer";
else if (mode == "firmware-upgrade")
    status_text = "Updating firmware, don't turn off your computer";
else
    status_text = "";
show_progress = (mode == "boot" || mode == "updates" || mode == "system-upgrade" || mode == "firmware-upgrade");

# Everything that depends on the screen size; again when a display comes or
# goes (the firmware framebuffer handing over to the GPU's driver, say).
fun layout() {
    global.W = Window.GetWidth();
    global.H = Window.GetHeight();
    global.X = Window.GetX();
    global.Y = Window.GetY();
    global.scale = Math.Clamp(Math.Min(global.W / 1920, global.H / 1080), 0.75, 4);
    if (global.scale > 1.4) {
        global.suffix = "@2x";
        global.k = global.scale / 2;
    } else {
        global.suffix = "";
        global.k = global.scale;
    }
    s = global.scale;
    cx = global.X + global.W / 2;

    global.penguin_image = load("penguin");
    global.flipper_image = load("flipper");
    global.bubble_big = load("bubble");
    global.bubble_small = load("bubble-small");
    wordmark_image = load("wordmark");
    sheet = Image("water" + global.suffix + ".png");
    fw = sheet.GetWidth() / COLUMNS;
    fh = sheet.GetHeight() / Math.Int((FRAMES + COLUMNS - 1) / COLUMNS);
    for (i = 0; i < FRAMES; i++)
        global.frames[i] = scaled(sheet.Crop((i % COLUMNS) * fw, Math.Int(i / COLUMNS) * fh, fw, fh), global.k);

    # The mark (256 x 90 px at 1080p) and the wordmark, 28 px apart, a little
    # above the middle.
    mark_w = 256 * s;
    mark_h = MARK_H * s;
    gap = 28 * s;
    group = mark_h + gap + wordmark_image.GetHeight();
    top = global.Y + global.H * 0.47 - group / 2;
    global.mark_x = cx - mark_w / 2;
    global.mark_y = top;
    wordmark_bottom = top + mark_h + gap + wordmark_image.GetHeight();
    place(global.wordmark, wordmark_image, cx - wordmark_image.GetWidth() / 2,
          top + mark_h + gap, 10);
    swim(global.tick);

    # Below the wordmark: the progress water line (as wide as the wordmark),
    # or the status line, or the passphrase prompt.
    global.below = wordmark_bottom + 40 * s;
    track_image = load("track");
    global.track_w = track_image.GetWidth();
    place(global.track, track_image, cx - global.track_w / 2, global.below, 10);
    global.fill_image = load("fill");
    global.fill_h = global.fill_image.GetHeight();
    global.fill.SetPosition(Math.Int(cx - global.track_w / 2), Math.Int(global.below), 11);
    if (global.status_text != "") {
        img = slate(global.status_text, 11);
        y = global.below;
        if (global.show_progress)
            y = global.below + track_image.GetHeight() + 16 * s;
        place(global.status, img, cx - img.GetWidth() / 2, y, 10);
    }

    global.entry_image = scaled(Image("entry.png"), s / 2);
    global.bullet_image = scaled(Image("bullet.png"), s / 2);
    global.cx = cx;
    redraw_progress();
    redraw_message();
    redraw_prompt();
}

# One frame of the swim at tick t. The penguin and its flipper turn about
# their own centres (penguin.png is centred on PIVOT, flipper.png on ROOT);
# the wake (the water sheet) bobs with the penguin; bubbles are in the water,
# so they do not.
fun swim(t) {
    s = global.scale;
    a = 2 * Math.Pi * (t % CYCLE) / CYCLE;
    bob = BOB * s * Math.Sin(a);
    pitch = -PITCH * Math.Cos(a);
    flap = FLAP * Math.Sin(2 * a);
    mx = global.mark_x;
    my = global.mark_y + bob;

    img = global.penguin_image.Rotate(pitch);
    place(global.penguin, img, mx + PIVOT_X * s - img.GetWidth() / 2,
          my + PIVOT_Y * s - img.GetHeight() / 2, 12);
    img = global.flipper_image.Rotate(pitch + flap);
    place(global.flipper, img, mx + ROOT_X * s - img.GetWidth() / 2,
          my + ROOT_Y * s - img.GetHeight() / 2, 13);
    place(global.water, global.frames[Math.Int(t / TICKS) % FRAMES],
          mx + WATER_X * s, my + WATER_Y * s, 10);

    for (i = 0; i < BUBBLE_COUNT; i++) {
        age = t - i * BUBBLE_EVERY;
        if (age < 0) {
            global.bubbles[i].SetOpacity(0);
        } else {
            n = Math.Int(age / BUBBLE_LIFE);
            age = age - n * BUBBLE_LIFE;
            v = (n + i) % 3;
            if (v == 0) {
                sx = SPAWN_X0;
                sy = SPAWN_Y0;
            } else if (v == 1) {
                sx = SPAWN_X1;
                sy = SPAWN_Y1;
            } else {
                sx = SPAWN_X2;
                sy = SPAWN_Y2;
            }
            if ((n + i) % 2 == 0)
                img = global.bubble_big;
            else
                img = global.bubble_small;
            life = age / BUBBLE_LIFE;
            x = mx + (sx - BUBBLE_VX * age / 50) * s;
            y = global.mark_y + (sy - BUBBLE_VY * age / 50 + BUBBLE_WOBBLE * Math.Sin(3 * Math.Pi * life)) * s;
            place(global.bubbles[i], img, x - img.GetWidth() / 2, y - img.GetHeight() / 2, 11);
            global.bubbles[i].SetOpacity(BUBBLE_ALPHA * Math.Sin(Math.Pi * life) * global.fade);
        }
    }
}

fun redraw_progress() {
    on = global.show_progress && global.state == "normal";
    global.track.SetOpacity(on);
    w = Math.Int(global.track_w * Math.Clamp(global.progress, 0, 1));
    if (on && w > 0) {
        # The Lime wave cut to the progress, not squeezed: the water line
        # fills from the left.
        global.fill.SetImage(global.fill_image.Crop(0, 0, w, global.fill_h));
        global.fill.SetOpacity(1);
    } else {
        global.fill.SetOpacity(0);
    }
    global.status.SetOpacity(global.state == "normal");
}

fun redraw_message() {
    if (global.message_text == "") {
        global.message.SetOpacity(0);
        return;
    }
    img = slate(global.message_text, 10);
    place(global.message, img, global.cx - img.GetWidth() / 2,
          global.Y + global.H - 64 * global.scale - img.GetHeight(), 10);
    global.message.SetOpacity(1);
}

fun redraw_prompt() {
    asking = global.state != "normal";
    global.prompt.SetOpacity(asking);
    global.entry.SetOpacity(asking);
    global.capslock.SetOpacity(0);
    for (i = 0; global.bullets[i]; i++)
        global.bullets[i].SetOpacity(0);
    if (!asking)
        return;
    s = global.scale;
    label = global.prompt_text;
    if (label == "")
        label = "Passphrase";
    img = mist(label, 11);
    place(global.prompt, img, global.cx - img.GetWidth() / 2, global.below, 20);
    ex = global.cx - global.entry_image.GetWidth() / 2;
    ey = global.below + img.GetHeight() + 14 * s;
    place(global.entry, global.entry_image, ex, ey, 20);
    global.entry_y = ey;
    if (global.state == "password") {
        # One Lime dot per character, centred; as many as fit.
        step = global.bullet_image.GetWidth() * 1.8;
        room = Math.Int((global.entry_image.GetWidth() - 32 * s) / step);
        n = Math.Min(global.bullet_count, room);
        bx = global.cx - (n * step - (step - global.bullet_image.GetWidth())) / 2;
        by = ey + (global.entry_image.GetHeight() - global.bullet_image.GetHeight()) / 2;
        for (i = 0; i < n; i++) {
            if (!global.bullets[i])
                global.bullets[i] = Sprite();
            place(global.bullets[i], global.bullet_image, bx + i * step, by, 21);
            global.bullets[i].SetOpacity(1);
        }
    } else {
        # A question: show what is typed.
        img = mist(global.answer, 11);
        if (!global.bullets[0])
            global.bullets[0] = Sprite();
        place(global.bullets[0], img, global.cx - img.GetWidth() / 2,
              ey + (global.entry_image.GetHeight() - img.GetHeight()) / 2, 21);
        global.bullets[0].SetOpacity(1);
    }
    caps = slate("Caps Lock is on", 10);
    place(global.capslock, caps, global.cx - caps.GetWidth() / 2,
          ey + global.entry_image.GetHeight() + 12 * s, 20);
}

fun refresh() {
    global.tick++;
    # Everything fades in over the first half second.
    global.fade = Math.Clamp(global.tick / 25, 0, 1);
    global.wordmark.SetOpacity(global.fade);
    global.water.SetOpacity(global.fade);
    global.penguin.SetOpacity(global.fade);
    global.flipper.SetOpacity(global.fade);
    # 25 frames a second, like the water sheet. The penguin keeps swimming
    # while the passphrase prompt waits.
    if (global.tick % TICKS == 0)
        swim(global.tick);
    if (global.state != "normal")
        global.capslock.SetOpacity(Plymouth.GetCapslockState());
}

fun boot_progress(duration, value) {
    global.progress = value;
    redraw_progress();
}

fun system_update(value) {
    # Offline updates report a percentage.
    global.progress = value / 100;
    redraw_progress();
}

fun display_normal() {
    global.state = "normal";
    redraw_progress();
    redraw_prompt();
}

fun display_password(text, count) {
    global.state = "password";
    global.prompt_text = text;
    global.bullet_count = count;
    redraw_progress();
    redraw_prompt();
}

fun display_question(text, answer) {
    global.state = "question";
    global.prompt_text = text;
    global.answer = answer;
    redraw_progress();
    redraw_prompt();
}

fun display_message(text) {
    global.message_text = text;
    redraw_message();
}

fun hide_message(text) {
    if (text == global.message_text) {
        global.message_text = "";
        redraw_message();
    }
}

layout();
Plymouth.SetRefreshFunction(refresh);
Plymouth.SetBootProgressFunction(boot_progress);
Plymouth.SetSystemUpdateFunction(system_update);
Plymouth.SetDisplayNormalFunction(display_normal);
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayQuestionFunction(display_question);
Plymouth.SetDisplayMessageFunction(display_message);
Plymouth.SetHideMessageFunction(hide_message);
Plymouth.SetDisplayHotplugFunction(layout);
