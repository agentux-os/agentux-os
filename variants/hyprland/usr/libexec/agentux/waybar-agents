#!/usr/bin/bash
# Waybar's custom/agents module: what agentuxd's runs are doing, as one line
# of Waybar JSON ({"text", "tooltip", "class"}; the module sets
# "return-type": "json"). Classes:
#   offline  the daemon is not reachable (or aux is missing)
#   idle     no active runs
#   running  active runs, nothing waiting for you
#   waiting  approvals or questions waiting for you (the style shows it in Lime)
# Reads `aux ps --json`, the daemon's own summary in a stable form
# (agentux-core docs/api.md, "aux ps --json"): exit 3 with {"daemon":"down"}
# when the daemon is not reachable. The socket is aux's default
# ($AGENTUX_SOCKET, else $XDG_RUNTIME_DIR/agentux/agentuxd.sock). Always
# prints exactly one JSON object and exits 0, so Waybar never shows a stale or
# broken module.
set -uo pipefail

nl=$'\n'
click="Click to open the AgentUX cockpit (Super+A)"

emit() {
    jq -cn --arg text "$1" --arg tooltip "$2" --arg class "$3" \
        '{text: $text, tooltip: $tooltip, class: $class, alt: $class}'
}

if ! command -v aux >/dev/null 2>&1; then
    emit "agents off" "aux is not installed.${nl}$click" offline
    exit 0
fi

out="$(timeout 4 aux ps --json 2>/dev/null)"
status=$?

if (( status != 0 )) || ! jq -e '.daemon == "up"' >/dev/null 2>&1 <<<"$out"; then
    if (( status == 3 )) || jq -e '.daemon == "down"' >/dev/null 2>&1 <<<"$out"; then
        emit "agents off" "agentuxd is not running or not reachable.${nl}$click" offline
    else
        emit "agents ?" "Could not read aux ps --json (exit $status).${nl}$click" offline
    fi
    exit 0
fi

# jq builds the text, tooltip and class from the summary, escaping
# everything that came from the daemon for Pango.
jq -c --arg click "$click" '
    def esc: tostring | gsub("&"; "&amp;") | gsub("<"; "&lt;") | gsub(">"; "&gt;");
    (.runs // []) as $runs
    | (.pending // []) as $pending
    | ($runs | length) as $n
    | ([$runs[] | select(.status == "running")] | length) as $running
    | ($pending | length) as $m
    | ("\($n) active run\(if $n == 1 then "" else "s" end), \($running) running"
        + ($runs | map("\n" + ("\(.id)  \(.status)  \(.step)  \(.title)"
            + (if .activity then " — \(.activity)" else "" end)) | esc) | add // ""))
      as $runs_tip
    | ($pending | map("\n" + ("\(.id)  \(.kind)  run \(.runId)  \(.title)" | esc)) | add // "")
      as $pending_tip
    | if $m > 0 then
        {text: "agents \($n) · \($m) waiting",
         tooltip: "\($runs_tip)\n\n<b>Waiting for you</b> (aux approve / deny / answer)\($pending_tip)\n\n\($click)",
         class: "waiting"}
      elif $n > 0 then
        {text: "agents \($n)", tooltip: "\($runs_tip)\n\n\($click)", class: "running"}
      else
        {text: "agents 0", tooltip: "No active runs.\n\($click)", class: "idle"}
      end
    | .alt = .class
' <<<"$out" || emit "agents ?" "Could not read aux ps --json.${nl}$click" offline
