# AgentUX boot splash (Plymouth script plugin).
#
# The mark sits dimmed in the middle of an Ink screen with the wordmark below
# it, and short lit dashes run along its four lanes, reach the merge together
# and leave along the line as one: the wallpaper's "messages on the bus". A
# Lime hairline under the wordmark shows boot progress; the passphrase prompt
# (LUKS), messages and the shutdown, reboot and update modes reuse the same
# layout. Sizes are for a 1080p screen and scale with the screen; the images
# come at 1x and @2x (see plymouth/build.py in agentux-os, which also checks
# that FRAMES and COLUMNS below match the sprite sheets).

FRAMES = 45;       # dash frames in dashes.png / dashes@2x.png
COLUMNS = 9;       # frames per row in those sheets
TICKS = 2;         # refresh ticks (50 Hz) per frame: 25 fps
PAUSE = 15;        # frames with no dash between two runs (0.6 s)
DIM = 0.62;        # the mark's opacity while dashes run on it (the wallpaper's lanes)

Window.SetBackgroundTopColor(0.043, 0.051, 0.063);
Window.SetBackgroundBottomColor(0.043, 0.051, 0.063);

fun text_image(text, size, r, g, b, a) {
    return Image.Text(text, r, g, b, a, "Sans " + Math.Int(Math.Max(size * global.scale, 9)));
}
fun slate(text, size) { return text_image(text, size, 0.580, 0.616, 0.671, 1); }
fun mist(text, size) { return text_image(text, size, 0.906, 0.918, 0.937, 1); }

# An image from the 1x or @2x set, scaled to the screen.
fun load(name) {
    img = Image(name + global.suffix + ".png");
    return scaled(img, global.k);
}
fun scaled(img, f) {
    if (f == 1)
        return img;
    return img.Scale(Math.Max(Math.Int(img.GetWidth() * f + 0.5), 1),
                     Math.Max(Math.Int(img.GetHeight() * f + 0.5), 1));
}

fun place(sprite, image, x, y, z) {
    sprite.SetImage(image);
    sprite.SetPosition(Math.Int(x), Math.Int(y), z);
}

mark = Sprite();
dash = Sprite();
wordmark = Sprite();
mark.SetOpacity(0);
dash.SetOpacity(0);
wordmark.SetOpacity(0);
track = Sprite();
fill = Sprite();
status = Sprite();
message = Sprite();
prompt = Sprite();
entry = Sprite();
capslock = Sprite();
bullets = [];

state = "normal";      # normal, password or question
progress = 0;
tick = 0;
message_text = "";

mode = Plymouth.GetMode();
if (mode == "shutdown")
    status_text = "Shutting down";
else if (mode == "reboot")
    status_text = "Restarting";
else if (mode == "updates" || mode == "system-upgrade")
    status_text = "Installing updates, don't turn off your computer";
else if (mode == "firmware-upgrade")
    status_text = "Updating firmware, don't turn off your computer";
else
    status_text = "";
show_progress = (mode == "boot" || mode == "updates" || mode == "system-upgrade" || mode == "firmware-upgrade");

# Everything that depends on the screen size; again when a display comes or
# goes (the firmware framebuffer handing over to the GPU's driver, say).
fun layout() {
    global.W = Window.GetWidth();
    global.H = Window.GetHeight();
    global.X = Window.GetX();
    global.Y = Window.GetY();
    global.scale = Math.Clamp(Math.Min(global.W / 1920, global.H / 1080), 0.75, 4);
    if (global.scale > 1.4) {
        global.suffix = "@2x";
        global.k = global.scale / 2;
    } else {
        global.suffix = "";
        global.k = global.scale;
    }
    s = global.scale;
    cx = global.X + global.W / 2;

    mark_image = load("mark");
    wordmark_image = load("wordmark");
    sheet = Image("dashes" + global.suffix + ".png");
    fw = sheet.GetWidth() / COLUMNS;
    fh = sheet.GetHeight() / Math.Int((FRAMES + COLUMNS - 1) / COLUMNS);
    for (i = 0; i < FRAMES; i++)
        global.frames[i] = scaled(sheet.Crop((i % COLUMNS) * fw, Math.Int(i / COLUMNS) * fh, fw, fh), global.k);

    # The mark and the wordmark, 30 px apart, a little above the middle.
    gap = 30 * s;
    group = mark_image.GetHeight() + gap + wordmark_image.GetHeight();
    top = global.Y + global.H * 0.47 - group / 2;
    global.mark_x = cx - mark_image.GetWidth() / 2;
    global.mark_y = top;
    place(global.mark, mark_image, global.mark_x, global.mark_y, 10);
    global.dash.SetPosition(Math.Int(global.mark_x), Math.Int(global.mark_y), 11);
    wordmark_bottom = top + mark_image.GetHeight() + gap + wordmark_image.GetHeight();
    place(global.wordmark, wordmark_image, cx - wordmark_image.GetWidth() / 2,
          top + mark_image.GetHeight() + gap, 10);

    # Below the wordmark: the progress hairline, or the status line, or the
    # passphrase prompt.
    global.below = wordmark_bottom + 44 * s;
    global.track_w = Math.Int(112 * s);
    track_h = Math.Max(Math.Int(2 * s + 0.5), 1);
    place(global.track, Image("track.png").Scale(global.track_w, track_h),
          cx - global.track_w / 2, global.below, 10);
    global.fill_image = Image("fill.png");
    global.fill_h = track_h;
    global.fill.SetPosition(Math.Int(cx - global.track_w / 2), Math.Int(global.below), 11);
    if (global.status_text != "") {
        img = slate(global.status_text, 11);
        y = global.below;
        if (global.show_progress)
            y = global.below + 18 * s;
        place(global.status, img, cx - img.GetWidth() / 2, y, 10);
    }

    global.entry_image = scaled(Image("entry.png"), s / 2);
    global.bullet_image = scaled(Image("bullet.png"), s / 2);
    global.cx = cx;
    redraw_progress();
    redraw_message();
    redraw_prompt();
}

fun redraw_progress() {
    on = global.show_progress && global.state == "normal";
    global.track.SetOpacity(on);
    w = Math.Int(global.track_w * Math.Clamp(global.progress, 0, 1));
    if (on && w > 0) {
        global.fill.SetImage(global.fill_image.Scale(w, global.fill_h));
        global.fill.SetOpacity(1);
    } else {
        global.fill.SetOpacity(0);
    }
    global.status.SetOpacity(global.state == "normal");
}

fun redraw_message() {
    if (global.message_text == "") {
        global.message.SetOpacity(0);
        return;
    }
    img = slate(global.message_text, 10);
    place(global.message, img, global.cx - img.GetWidth() / 2,
          global.Y + global.H - 64 * global.scale - img.GetHeight(), 10);
    global.message.SetOpacity(1);
}

fun redraw_prompt() {
    asking = global.state != "normal";
    global.prompt.SetOpacity(asking);
    global.entry.SetOpacity(asking);
    global.capslock.SetOpacity(0);
    for (i = 0; global.bullets[i]; i++)
        global.bullets[i].SetOpacity(0);
    if (!asking)
        return;
    s = global.scale;
    label = global.prompt_text;
    if (label == "")
        label = "Passphrase";
    img = mist(label, 11);
    place(global.prompt, img, global.cx - img.GetWidth() / 2, global.below, 20);
    ex = global.cx - global.entry_image.GetWidth() / 2;
    ey = global.below + img.GetHeight() + 14 * s;
    place(global.entry, global.entry_image, ex, ey, 20);
    global.entry_y = ey;
    if (global.state == "password") {
        # One Lime dot per character, centred; as many as fit.
        step = global.bullet_image.GetWidth() * 1.8;
        room = Math.Int((global.entry_image.GetWidth() - 32 * s) / step);
        n = Math.Min(global.bullet_count, room);
        bx = global.cx - (n * step - (step - global.bullet_image.GetWidth())) / 2;
        by = ey + (global.entry_image.GetHeight() - global.bullet_image.GetHeight()) / 2;
        for (i = 0; i < n; i++) {
            if (!global.bullets[i])
                global.bullets[i] = Sprite();
            place(global.bullets[i], global.bullet_image, bx + i * step, by, 21);
            global.bullets[i].SetOpacity(1);
        }
    } else {
        # A question: show what is typed.
        img = mist(global.answer, 11);
        if (!global.bullets[0])
            global.bullets[0] = Sprite();
        place(global.bullets[0], img, global.cx - img.GetWidth() / 2,
              ey + (global.entry_image.GetHeight() - img.GetHeight()) / 2, 21);
        global.bullets[0].SetOpacity(1);
    }
    caps = slate("Caps Lock is on", 10);
    place(global.capslock, caps, global.cx - caps.GetWidth() / 2,
          ey + global.entry_image.GetHeight() + 12 * s, 20);
}

fun refresh() {
    global.tick++;
    # The mark and the wordmark fade in over the first half second.
    fade = Math.Clamp(global.tick / 25, 0, 1);
    global.wordmark.SetOpacity(fade);
    if (global.state != "normal") {
        # Waiting for the user: the mark lit and still.
        global.mark.SetOpacity(1);
        global.dash.SetOpacity(0);
        global.capslock.SetOpacity(Plymouth.GetCapslockState());
        return;
    }
    global.mark.SetOpacity(DIM * fade);
    f = Math.Int(global.tick / TICKS) % (FRAMES + PAUSE);
    if (f < FRAMES) {
        global.dash.SetImage(global.frames[f]);
        global.dash.SetOpacity(fade);
    } else {
        global.dash.SetOpacity(0);
    }
}

fun boot_progress(duration, value) {
    global.progress = value;
    redraw_progress();
}

fun system_update(value) {
    # Offline updates report a percentage.
    global.progress = value / 100;
    redraw_progress();
}

fun display_normal() {
    global.state = "normal";
    redraw_progress();
    redraw_prompt();
}

fun display_password(text, count) {
    global.state = "password";
    global.prompt_text = text;
    global.bullet_count = count;
    redraw_progress();
    redraw_prompt();
}

fun display_question(text, answer) {
    global.state = "question";
    global.prompt_text = text;
    global.answer = answer;
    redraw_progress();
    redraw_prompt();
}

fun display_message(text) {
    global.message_text = text;
    redraw_message();
}

fun hide_message(text) {
    if (text == global.message_text) {
        global.message_text = "";
        redraw_message();
    }
}

layout();
Plymouth.SetRefreshFunction(refresh);
Plymouth.SetBootProgressFunction(boot_progress);
Plymouth.SetSystemUpdateFunction(system_update);
Plymouth.SetDisplayNormalFunction(display_normal);
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayQuestionFunction(display_question);
Plymouth.SetDisplayMessageFunction(display_message);
Plymouth.SetHideMessageFunction(hide_message);
Plymouth.SetDisplayHotplugFunction(layout);
